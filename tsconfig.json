{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "@pages/*": ["pages/*"], "@support/*": ["support/*"] }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}